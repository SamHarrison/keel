{ "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "required": ["links"],
  "additionalProperties": false,
  "properties": { "links": { "type": "array", "items": {
      "type": "object", "required": ["from","spec","relation"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+(@[0-9]+)?$",
          "description": "source alias: a BRD row or a scenario"},
        "spec": {"type": "array", "minItems": 1, "items": {"type": "string",
          "pattern": "^([a-z]+[-._][a-z]+(@[0-9]+)?|section:[a-z][a-z0-9-]*)$"}},
        "relation": {"enum": ["satisfies","partial","informs","conflicts"]},
        "note": {"type": "string"} } } } } }
