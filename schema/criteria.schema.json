{ "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "required": ["section", "criteria"],
  "additionalProperties": false,
  "properties": { "section": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "criteria": { "type": "array", "maxItems": 1000, "items": {
      "type": "object",
      "required": ["uid", "alias", "version", "layer", "type", "text", "witness", "refines"],
      "additionalProperties": false,
      "properties": {
        "uid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{5}$"},
        "alias": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+$"},
        "version": {"type": "integer", "minimum": 1},
        "layer": {"const": "criterion"},
        "type": {"enum": ["functional","interface","quality","constraint","process","definition"]},
        "term": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "witness": {"enum": ["test","demo","analysis","inspection","none"]},
        "refines": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+@[0-9]+$"},
        "refs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+(@[0-9]+)?$"}},
        "rationale": {"type": "string"},
        "tbd": {"$ref": "tbx.schema.json"} },
      "allOf": [
        { "if": {"properties": {"type": {"const": "definition"}}, "required": ["type"]},
          "then": {"required": ["term"]},
          "else": {"properties": {"term": false}} } ] } } } }
