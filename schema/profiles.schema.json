{ "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "required": ["id", "uid", "alias", "version", "slug", "kind", "rank"],
  "additionalProperties": false,
  "allOf": [
    { "if": {"properties": {"kind": {"const": "customer"}}, "required": ["kind"]},
      "then": {"required": ["status"],
               "properties": {"id": {"pattern": "^CP-[0-9]+$"}}},
      "else": {"properties": {"status": false,
               "id": {"pattern": "^IP-[0-9]+$"}}} } ],
  "properties": {
    "id": {"type": "string", "pattern": "^(CP|IP)-[0-9]+$"},
    "uid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{5}$"},
    "alias": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+$"},
    "version": {"type": "integer", "minimum": 1},
    "slug": {"type": "string"},
    "kind": {"enum": ["customer", "internal"]},
    "rank": {"type": "integer", "minimum": 1},
    "status": {"enum": ["icp", "secondary", "parked"]},
    "persona": { "type": "object", "additionalProperties": false,
      "properties": { "role": {"type": "string"}, "proficiency": {"type": "string"} } },
    "context": { "type": "object", "additionalProperties": false,
      "properties": {
        "environment": {"type": "string"},
        "scale": { "type": "object", "additionalProperties": false,
          "properties": {
            "users_min": {"type": "integer", "minimum": 0},
            "users_max": {"type": "integer", "minimum": 0} } } } },
    "stakeholders": { "type": "array", "items": {
      "type": "object", "required": ["uid", "alias", "version", "role"],
      "additionalProperties": false,
      "properties": {
        "uid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{5}$"},
        "alias": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+$"},
        "version": {"type": "integer", "minimum": 1},
        "role": {"type": "string", "minLength": 1},
        "tbd": {"$ref": "tbx.schema.json"} } } },
    "constraints": { "type": "array", "items": {
      "type": "object", "required": ["uid", "alias", "version", "text"],
      "additionalProperties": false,
      "properties": {
        "uid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{5}$"},
        "alias": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+$"},
        "version": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1},
        "tbd": {"$ref": "tbx.schema.json"} } } } } }
