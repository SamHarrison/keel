{ "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "required": ["question","owner","opened","trigger"],
  "additionalProperties": false,
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "opened": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "trigger": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["open","deferred","out-of-scope"]},
    "reopen": {"type": "string"}, "ref": {"type": "string"} },
  "allOf": [
    { "if": {"properties": {"disposition": {"const": "out-of-scope"}}, "required": ["disposition"]},
      "then": {"required": ["reopen"]} } ] }
