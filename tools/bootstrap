#!/bin/sh
# Idempotent environment bootstrap: venv + deps + hooks + ledger.
# Safe to re-run; used by `make init`, the no-mistakes gate commands, and CI
# rehearsals. A git clone can never run code on you — running this is the
# one deliberate act that arms Ring 1.
set -e
cd "$(dirname "$0")/.."
[ -d .venv ] || python3 -m venv .venv
# arxivhaiku pinned by commit SHA (R-2): v1.0.2 lineage, the commit the
# wordlist pins in keel.yaml were computed against. Moving this pin without
# re-verifying those digests will fail `req lint` — that is the point.
.venv/bin/pip install -q pyyaml jsonschema \
  "git+https://github.com/SamHarrison/arxivhaiku@e55d48335ba07fd5c1be3665a942a56e553b5543"
.venv/bin/python tools/req init
