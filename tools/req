    m = sp.add_parser("mint"); m.add_argument("--separator", default=None); m.set_defaults(fn=cmd_mint)
    r = sp.add_parser("resolve"); r.add_argument("ref"); r.set_defaults(fn=cmd_resolve)
    l = sp.add_parser("lint"); l.add_argument("--staged", action="store_true")
    l.add_argument("--strict-new", action="store_true"); l.set_defaults(fn=cmd_lint)
    v = sp.add_parser("version"); v.add_argument("--check", action="store_true")
    v.add_argument("--audit", action="store_true"); v.add_argument("--base", default="HEAD")
    v.set_defaults(fn=cmd_version)
    x = sp.add_parser("xref"); x.add_argument("--staged", action="store_true"); x.set_defaults(fn=cmd_xref)
    t = sp.add_parser("trace"); t.add_argument("--gate", action="store_true"); t.set_defaults(fn=cmd_trace)
    s = sp.add_parser("slice"); s.add_argument("expr"); s.set_defaults(fn=cmd_slice)
    rn = sp.add_parser("render"); rn.add_argument("--verify", action="store_true")
    rn.set_defaults(fn=cmd_render)
    rt = sp.add_parser("rtm"); rt.add_argument("--results", default=None)
    rt.add_argument("--gate", action="store_true"); rt.set_defaults(fn=cmd_rtm)
    me = sp.add_parser("measure"); me.set_defaults(fn=cmd_measure)
    mg = sp.add_parser("migrate")
    mgs = mg.add_subparsers(dest="sub", required=True)
    ma = mgs.add_parser("audit"); ma.add_argument("--count", action="store_true")
    mm = mgs.add_parser("merge")
    mm.add_argument("--v1", nargs="+", required=True)
    mm.add_argument("--v2", nargs="+", required=True)
    mm.add_argument("--out", required=True); mm.add_argument("--conflicts", required=True)
    mp = mgs.add_parser("apply"); mp.add_argument("files", nargs="+")
    mg.set_defaults(fn=cmd_migrate)
    b = sp.add_parser("baseline"); b.add_argument("cutname", nargs="?", default="cut")
    b.add_argument("name", nargs="?", default=None); b.set_defaults(fn=cmd_baseline)
