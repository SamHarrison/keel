CODE_DIRS = ["src", "lib", "app", "tests", "scripts"]


def code_files():
    for d in CODE_DIRS:
        p = ROOT / d
        if p.is_dir():
            for f in sorted(p.rglob("*")):
                if f.is_file() and f.suffix not in (".png", ".jpg", ".pdf"):
                    yield f


def code_citations():
    """Yield (file, line, kind, alias, version, method) from req:implements /
    req:witnesses annotations and test-name citations (alias@N #method)."""
    for f in code_files():
        try:
            text = f.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        for i, line in enumerate(text.splitlines(), 1):
            m = IMPL_RE.search(line)
            if m:
                kind = m.group(1).lower()
                for tok in re.split(r"[ ,]+", m.group(2).strip()):
                    if not tok:
                        continue
                    alias, _, ver = tok.partition("@")
                    yield (f, i, kind, alias, int(ver) if ver else None, None)
            elif "tests" in f.parts:
                for m2 in refs.TEST_CITE_RE.finditer(line):
                    yield (f, i, "witnesses", m2.group(1), int(m2.group(2)),
                           m2.group(3) or "test")


def rtm_graph():
    """The whole traceability graph, compiled from authored surfaces
    (docs/process.md §19). Everything derived renders from this."""
    ids = all_identities()
    brd, prd, profiles = {}, {}, {}
    for f, kind, row in yaml_rows():
        if is_placeholder(row):
            continue
        if kind == "profile":
            profiles[row["alias"]] = {"kind": row.get("kind"),
                                      "rank": row.get("rank"),
                                      "status": row.get("status")}
        elif kind == "brd":
            data = yaml.safe_load(f.read_text()) or {}
            brd[row["alias"]] = {
                "uid": row.get("uid"), "version": row.get("version", 1),
                "statement": row.get("statement", ""),
                "profile": (data.get("meta") or {}).get("profile"),
                "stakeholder": row.get("stakeholder_alias"),
                "priority_buying": row.get("priority_buying"),
                "links": [], "anchors": row.get("anchors") or []}
        elif kind == "prd":
            prd[row["alias"]] = {
                "uid": row.get("uid"), "version": row.get("version", 1),
                "text": row.get("text", ""), "type": row.get("type"),
                "witness": row.get("witness"),
                "priority_po": row.get("priority_po"),
                "section": (yaml.safe_load(f.read_text()) or {}).get("section"),
                "parents": [], "inbound": [], "arch": [], "code": [],
                "tests": []}
    links = links_data().get("links") or []
    scenarios = {}
    for f, fm, body in scenario_files():
        if fm and "alias" in fm:
            scenarios[fm["alias"]] = {
                "uid": fm.get("uid"), "version": fm.get("version", 1),
                "slug": fm.get("slug"), "mode": fm.get("mode"),
                "stakeholder": fm.get("stakeholder_alias"), "links": []}
    for l in links:
        b = (l.get("from") or "").partition("@")[0]
        if b in brd:
            brd[b]["links"].append(l)
        elif b in scenarios:
            scenarios[b]["links"].append(l)
        for tgt in (l.get("spec") or []):
            a = tgt.partition("@")[0]
            if a in prd:
                prd[a]["parents"].append(b)
                if b in brd:
                    prd[a]["inbound"].append(
                        {"from": b, "relation": l.get("relation")})
            m = refs.SECTION_RE.match(tgt)
            if m:
                for a2, r2 in prd.items():
                    if r2["section"] == m.group(1):
                        r2["parents"].append(b)
                        if b in brd:
                            r2["inbound"].append(
                                {"from": b, "relation": l.get("relation")})
    arch = DOCS / "architecture.md"
    arch_cites = []
    if arch.exists():
        atext = re.sub(r"`[^`\n]*`", lambda m: m.group(0), arch.read_text())
        for a in list(prd) + list(brd):
            if a in atext:
                arch_cites.append(a)
                if a in prd:
                    prd[a]["arch"].append("architecture.md")
    for f in (DOCS / "decisions").glob("*.md"):
        if f.stem.startswith("00000000"):
            continue
        head = f.read_text().split("---")
        try:
            fm = yaml.safe_load(head[1]) if len(head) > 2 else {}
        except Exception:
            fm = {}
        for a in ((fm or {}).get("traces") or []):
            a = str(a).partition("@")[0]
            if a in prd:
                prd[a]["arch"].append(f.stem)
    code, tests, orphan_cites, stale_cites = [], [], [], []
    for f, ln, kind2, alias, ver, method in code_citations():
        where = f"{f.relative_to(ROOT)}:{ln}"
        entry = {"where": where, "alias": alias, "version": ver,
                 "method": method, "kind": kind2}
        (code if kind2 == "implements" else tests).append(entry)
        if alias not in ids:
            orphan_cites.append(f"{where}: {kind2} unknown identity {alias}")
        elif ver is not None and ver != ids[alias]["version"]:
            stale_cites.append(f"{where}: cites {alias}@{ver}, current "
                               f"@{ids[alias]['version']}")
        elif alias in prd:
            prd[alias]["code" if kind2 == "implements" else "tests"].append(where)
    return {"ids": ids, "profiles": profiles, "brd": brd, "prd": prd,
            "scenarios": scenarios,
            "links": links, "arch_cites": arch_cites, "code": code,
            "tests": tests, "orphan_cites": orphan_cites,
            "stale_cites": stale_cites}


def rtm_status(g, results=None):
    """Three-valued verdict per PRD row: witnessed / unwitnessed(reason) /
    not-provable-by-test. Method-match: a row is proven only by its own
    witness class."""
    results = results or {}
    out = {}
    for alias, row in g["prd"].items():
        wit = row.get("witness", "none")
        if wit == "none":
            out[alias] = ("not-provable-by-test",
                          "witness: none — validated elsewhere")
            continue
        cites = [c for c in g["tests"] if c["alias"] == alias]
        if not cites:
            out[alias] = ("unwitnessed", "no test cites it")
            continue
        current = [c for c in cites
                   if c["version"] in (None, row["version"])]
        if not current:
            out[alias] = ("unwitnessed", "citations pin old versions (stale)")
            continue
        matched = [c for c in current if c["method"] in (None, wit)]
        if not matched:
            out[alias] = ("unwitnessed",
                          f"needs a {wit} witness, got "
                          f"{sorted({c['method'] for c in current})}")
            continue
        failing = [c for c in matched
                   if results.get(c["where"].split(":")[0]) == "fail"]
        if failing and len(failing) == len(matched):
            out[alias] = ("unwitnessed", "citing test is failing")
        else:
            out[alias] = ("witnessed", f"{len(matched)} citation(s)")
    return out


def rtm_gaps(g):
    """Downward holes; ICP priority-1 broken chains are the blocking class."""
    gaps, blocking = [], []
    armed = bool(g["prd"])   # before L2 (no real PRD rows) gaps are the
    for a, row in sorted(g["brd"].items()):   # worklist, not a failure
        if not row["links"]:
            msg = f"BRD {a}: no links.yaml entry (unimplemented need)"
            icp = (g["profiles"].get(row["profile"], {}).get("status") == "icp")
            if armed and icp and row.get("priority_buying") == 1:
                blocking.append(msg + " [ICP P1 — blocks]")
            else:
                gaps.append(msg)
    for a, row in sorted(g["prd"].items()):
        if not row["code"]:
            gaps.append(f"PRD {a}: no implementing element yet")
    for a, s in sorted(g.get("scenarios", {}).items()):
        if not s["links"]:
            gaps.append(f"scenario {a} ({s['mode']}): exercises no PRD rows "
                        f"yet (scenario coverage)")
    return gaps, blocking


def rtm_write(g, status):
    out = BUILD / "rtm"
    out.mkdir(parents=True, exist_ok=True)
    keep = {"rtm.json", "forward.md", "reverse.md", "gaps.md",
            "orphans.md", "stale.md", "priority.md"}
    for f in out.glob("*"):
        if f.name not in keep:
            f.unlink()                      # derived dir owns exactly seven views
    plain = {k: g[k] for k in ("profiles", "brd", "prd", "scenarios", "links",
                               "arch_cites", "code", "tests")}
    (out / "rtm.json").write_text(json.dumps(plain, indent=1, sort_keys=True,
                                             default=str) + "\n")
    ban = "(derived — do not edit; `req rtm` regenerates)"
    fwd = [f"# Forward trace {ban}", ""]
    for a, row in sorted(g["brd"].items()):
        fwd.append(f"## `{a}`@{row['version']} — {row['statement'][:90]}")
        fwd.append(f"- stakeholder: {row['stakeholder']} · profile "
                   f"{row['profile']} · P-buy {row['priority_buying']}")
        if not row["links"]:
            fwd.append("- ⛔ no PRD support (see gaps.md)")
        for l in row["links"]:
            for tgt in l.get("spec") or []:
                ta = tgt.partition("@")[0]
                st = status.get(ta, ("", ""))[0] if ta in g["prd"] else "section"
                fwd.append(f"- {l.get('relation')} → `{tgt}` [{st}]")
        fwd.append("")
    for a, s in sorted(g.get("scenarios", {}).items()):
        fwd.append(f"## scenario `{a}`@{s['version']} — {s['slug']} "
                   f"({s['mode']}, actor {s['stakeholder']})")
        if not s["links"]:
            fwd.append("- ⛔ exercises no PRD rows yet (see gaps.md)")
        for l in s["links"]:
            for tgt in l.get("spec") or []:
                fwd.append(f"- {l.get('relation')} → `{tgt}`")
        fwd.append("")
    (out / "forward.md").write_text("\n".join(fwd) + "\n")
    rev = [f"# Reverse trace {ban}", ""]
    for a, row in sorted(g["prd"].items()):
        st, why = status.get(a, ("?", ""))
        rev.append(f"## `{a}`@{row['version']} [{row['witness']}] — "
                   f"**{st}** · {why}")
        rev.append(f"- parents: {sorted(set(row['parents'])) or '⛔ none (orphan?)'}")
        rev.append(f"- architecture: {sorted(set(row['arch'])) or '—'}")
        rev.append(f"- code: {row['code'] or '—'} · tests: {row['tests'] or '—'}")
        rev.append("")
    (out / "reverse.md").write_text("\n".join(rev) + "\n")
    gaps, blocking = rtm_gaps(g)
    (out / "gaps.md").write_text(
        f"# Gaps — downward holes {ban}\n\n" +
        "\n".join(f"- {x}" for x in (blocking + gaps)) + "\n")
    orphans = [f"PRD {a}: nothing links to it (gold-plating?)"
               for a, r in sorted(g["prd"].items()) if not r["parents"]]
    orphans += g["orphan_cites"]
    (out / "orphans.md").write_text(
        f"# Orphans — upward holes {ban}\n\n" +
        ("\n".join(f"- {x}" for x in orphans) or "- none") + "\n")
    (out / "stale.md").write_text(
        f"# Stale pinned claims {ban}\n\n" +
        ("\n".join(f"- {x}" for x in g["stale_cites"]) or "- none") + "\n")
    # priority drift: authored priority_po vs link-inherited customer
    # priority (docs/process.md §3, §19) — divergence is evidence, not error
    drift = [f"# Priority drift — priority_po vs inherited {ban}", "",
             "Inherited = min `priority_buying` over `satisfies`/`partial` "
             "inbound BRD links. Δ = priority_po − inherited "
             "(negative: PO ranks it above customer voice).", "",
             "| PRD row | P_po | inherited | Δ | inbound (BRD · profile · P-buy · relation) |",
             "|---|---|---|---|---|"]
    rows = []
    for a, row in g["prd"].items():
        if row.get("type") == "definition":
            continue
        contrib = []
        inh = None
        for e in row.get("inbound", []):
            b = g["brd"].get(e["from"]) or {}
            pb = b.get("priority_buying")
            contrib.append(f"`{e['from']}` · {b.get('profile', '?')} · "
                           f"P{pb} · {e.get('relation')}")
            if e.get("relation") in ("satisfies", "partial") and pb:
                inh = pb if inh is None else min(inh, pb)
        po = row.get("priority_po")
        delta = (po - inh) if (po and inh) else None
        rows.append((delta, a, po, inh, contrib))
    rows.sort(key=lambda r: (-abs(r[0]) if r[0] is not None else 99,
                             r[1]))
    for delta, a, po, inh, contrib in rows:
        drift.append(f"| `{a}` | {po or '—'} | {inh or '—'} | "
                     f"{'%+d' % delta if delta is not None else '—'} | "
                     f"{'; '.join(contrib) or '⛔ no inbound links'} |")
    if not rows:
        drift.append("| — | — | — | — | no non-definition PRD rows yet |")
    (out / "priority.md").write_text("\n".join(drift) + "\n")
    return gaps, blocking, orphans


def cmd_rtm(args):
    """Bidirectional RTM, derived (build/rtm/): rtm.json + forward/reverse/
    gaps/orphans/stale/priority views. Status computed, never stored."""
    if getattr(args, "sub", None) == "impact":
        if not args.target:
            sys.exit("usage: req rtm impact ALIAS")
        return rtm_impact(args.target)
    g = rtm_graph()
    results = {}
    if args.results and Path(args.results).exists():
        results = json.loads(Path(args.results).read_text())
    status = rtm_status(g, results)
    gaps, blocking, orphans = rtm_write(g, status)
    counts = {}
    for st, _ in status.values():
        counts[st] = counts.get(st, 0) + 1
    print(f"rtm: {len(g['prd'])} PRD rows · {counts or '{}'} · "
          f"gaps {len(gaps) + len(blocking)} ({len(blocking)} blocking) · "
          f"orphans {len(orphans)} · stale {len(g['stale_cites'])} "
          f"→ build/rtm/ (7 views)")
    if args.gate and (blocking or g["orphan_cites"]):
        for b in blocking + g["orphan_cites"]:
            print(f"FAIL  {b}")
        sys.exit(1)


def rtm_impact(alias):
    """Downstream closure of a row — what a change to it touches
    (docs/process.md §19)."""
    g = rtm_graph()
    alias = alias.partition("@")[0]
    touched = {"prd": set(), "arch": set(), "code": set(), "tests": set()}
    seeds = {alias}
    if alias in g["brd"]:
        for l in g["brd"][alias]["links"]:
            for tgt in l.get("spec") or []:
                ta = tgt.partition("@")[0]
                m = refs.SECTION_RE.match(tgt)
                if m:
                    seeds |= {a for a, r in g["prd"].items()
                              if r["section"] == m.group(1)}
                elif ta in g["prd"]:
                    seeds.add(ta)
    for a in list(seeds):
        if a in g["prd"]:
            touched["prd"].add(a)
            touched["arch"] |= set(g["prd"][a]["arch"])
            touched["code"] |= set(g["prd"][a]["code"])
            touched["tests"] |= set(g["prd"][a]["tests"])
    print(f"impact of {alias}:")
    for k in ("prd", "arch", "code", "tests"):
        print(f"  {k}: " + (", ".join(sorted(touched[k])) or "—"))
    if alias not in g["brd"] and alias not in g["prd"]:
        print("  (alias not found in BRD/PRD — no downstream closure)")


def cmd_measure(args):
    """L5 measures per ISO 29148 §6.6.3: volatility, TBx age, witness debt."""
    import datetime
    today = datetime.date.today()
    lock = versioning.load_lock(ROOT)
    bumped = sum(1 for v in lock.values() if v["version"] > 1)
    tbx = []
    for f, kind, row in yaml_rows():
        tb = row.get("tbd")
        if tb and not is_placeholder(row):
            opened = tb.get("opened")
            try:
                if not isinstance(opened, datetime.date):
                    opened = datetime.date.fromisoformat(str(opened))
                age = (today - opened).days
            except ValueError:
                age = -1
            tbx.append((row["alias"], tb.get("disposition", "open"), age))
    prd = [row for _, k, row in yaml_rows()
           if k == "prd" and not is_placeholder(row)]
    none_wit = sum(1 for r in prd if r.get("witness") == "none")
    lines = ["# Measures (derived — do not edit)", "",
             f"- volatility: {bumped}/{len(lock) or 0} identities past v1",
             f"- TBx: {len(tbx)} open blocks; oldest "
             f"{max((a for _, _, a in tbx), default=0)} days",
             f"- witness debt: {none_wit}/{len(prd) or 0} PRD rows "
             f"not provable by test (witness: none)"]
    BUILD.mkdir(exist_ok=True)
    (BUILD / "measures.md").write_text("\n".join(lines) + "\n")
    print("\n".join(lines[2:]))


# ---------- migrate: HOLE audit / double-blind merge / apply (K-21) ----------
def hole_sites():
    """The ONE canonical hole traversal: authored files sorted, holes in
    source order. Shared by audit (display) and apply (write-back) so two
    passes can never number sites differently."""
    sites = []
    for f in list(yaml_files()) + list(md_files()):
        text = f.read_text()
        for m in refs.HOLE_RE.finditer(text):
            sites.append({"id": len(sites) + 1, "file": f,
                          "span": m.span(), "phrase": m.group("phrase"),
                          "was": m.group("was"),
                          "line": text[:m.start()].count("\n") + 1})
    return sites


def cmd_migrate(args):
    sub = args.sub
    if sub == "audit":
        sites = hole_sites()
        if args.count:
            print(f"{len(sites)} open hole(s)")
            return
        migmap = {}
        mp = ROOT / "ledger" / "migration-map.json"
        if mp.exists():
            migmap = json.loads(mp.read_text())
        ids = all_identities()
        worksheet = []
        for s in sites:
            text = s["file"].read_text()
            a, b = s["span"]
            window = (text[max(0, a - 140):a] + "⟨HOLE⟩" + text[b:b + 140]
                      ).replace("\n", " ")
            sug = migmap.get(s["was"])
            worksheet.append({
                "id": s["id"],
                "location": f"{s['file'].relative_to(ROOT)}:{s['line']}",
                "phrase": s["phrase"], "was": s["was"], "sentence": window,
                "suggestion": ({**sug, "resolves": sug.get("alias") in ids}
                               if sug else None)})
        print(json.dumps(worksheet, indent=2, ensure_ascii=False))
        if worksheet:
            print(f"\n# {len(worksheet)} hole(s). The suggestion is an anchor "
                  f"to be TESTED against the target text, never an answer. "
                  f"Two independent judgement passes, then `req migrate "
                  f"merge`, then `req migrate apply`.", file=sys.stderr)
    elif sub == "merge":
        v1 = {d["id"]: d for f in args.v1 for d in json.loads(Path(f).read_text())}
        v2 = {d["id"]: d for f in args.v2 for d in json.loads(Path(f).read_text())}
        agreed, conflicts = [], []
        for i in sorted(set(v1) | set(v2)):
            a, b = v1.get(i), v2.get(i)
            if a is None or b is None:
                conflicts.append({"id": i, "v1": a, "v2": b,
                                  "reason": "missing in one pass"})
            elif a.get("chosenAlias") == b.get("chosenAlias"):
                agreed.append(a)
            else:
                conflicts.append({"id": i, "v1": a, "v2": b})
        Path(args.out).write_text(json.dumps(agreed, indent=2))
        Path(args.conflicts).write_text(json.dumps(conflicts, indent=2))
        print(f"merge: {len(agreed)} agreed → {args.out} · "
              f"{len(conflicts)} conflict(s) → {args.conflicts} "
              f"(disagreements are never silently resolved — owner tiebreak)")
    elif sub == "apply":
        decisions = {}
        for f in args.files:
            for d in json.loads(Path(f).read_text()):
                decisions[d["id"]] = d
        ids = all_identities()
        sites = hole_sites()
        by_file = {}
        applied = skipped = 0
        for s in sites:
            d = decisions.get(s["id"])
            if not d or not d.get("chosenAlias"):
                skipped += 1
                continue
            alias = d["chosenAlias"]
            if alias not in ids:
                sys.exit(f"req migrate apply: site {s['id']} chose unknown "
                         f"identity {alias}")
            by_file.setdefault(s["file"], []).append(
                (s["span"], refs.render_pinned(alias, ids[alias]["version"])))
            applied += 1
        for f, edits in by_file.items():
            text = f.read_text()
            for (a, b), repl in sorted(edits, reverse=True):  # right-to-left
                text = text[:a] + repl + text[b:]
            f.write_text(text)
        print(f"apply: {applied} hole(s) re-attached · {skipped} left open "
              f"(the gate keeps failing until every hole is judged)")
        if applied:
            print("next: `req version` (bump/cascade) then `req xref`")


# ---------- baseline & init ---------------------------------------------------
def cmd_baseline(args):
    """Baselines force triage (K-6, K-19): overdue TBx and corpus-wide
    quality warnings block the tag."""
    import datetime
    blockers = []
    today = datetime.date.today()
    for f, kind, row in yaml_rows():
        tb = row.get("tbd")
        if not tb or is_placeholder(row):
            continue
        trig = str(tb.get("trigger", ""))
        m = re.match(r"^date:(\d{4}-\d{2}-\d{2})$", trig)
        if m and datetime.date.fromisoformat(m.group(1)) <= today:
            blockers.append(f"{row['alias']}: TBx date trigger {m.group(1)} "
                            f"is due — resolve or re-affirm before baselining")
        elif tb.get("disposition", "open") == "open":
            blockers.append(f"{row['alias']}: open TBx must be triaged "
                            f"(resolve, defer, or out-of-scope w/ reopen)")
    import io, contextlib
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        try:
            cmd_lint(argparse.Namespace(staged=False, strict_new=False))
        except SystemExit:
            pass
    for line in buf.getvalue().splitlines():
        if line.startswith("WARN"):
            blockers.append(f"untriaged quality warning: {line[6:]}")
        if line.startswith("FAIL"):
            blockers.append(f"gate failure: {line[6:]}")
    if blockers:
        for b in blockers:
            print(f"BLOCK  {b}")
        sys.exit(1)
    name = args.name or "baseline"
    code = subprocess.run(["git", "tag", f"baseline/{name}"], cwd=ROOT).returncode
    print(f"baseline: triage clean — " +
          (f"tagged baseline/{name}" if code == 0 else
           f"tag baseline/{name} yourself (git unavailable here)"))


def cmd_init(args):
    """Bootstrap a fresh clone: every artifact exists from minute one, even
    blank — the docs describe real files, never aspirations."""
    (ROOT / "ledger").mkdir(exist_ok=True)
    if not versioning.lock_path(ROOT).exists():
        versioning.save_lock(ROOT, {})
    arch = DOCS / "architecture.md"
    tmpl = DOCS / "templates" / "architecture.md"
    if not arch.exists() and tmpl.exists():
        arch.write_text(tmpl.read_text())
    subprocess.run(["git", "config", "core.hooksPath", ".githooks"], cwd=ROOT)
    ns = argparse.Namespace
    cmd_trace(ns(gate=False))
    cmd_render(ns(verify=False))
    cmd_rtm(ns(results=None, gate=False, sub=None, target=None))
    print("init: ledger · hooks · docs/architecture.md · build/ views all "
          "materialized (blank-state where no rows exist yet). Next: the "
          "inception playbook (docs/elicitation/playbooks/), then "
          "`req mint`. Smoke: make check")


