{ "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "required": ["meta", "requirements"],
  "additionalProperties": false,
  "properties": {
    "meta": { "type": "object", "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {"type": "string"},
        "version": {"type": ["number", "string"]} } },
    "requirements": { "type": "array", "maxItems": 40, "items": {
      "type": "object",
      "required": ["id","alias","version","statement","stakeholder","priority","acceptance","source"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer", "minimum": 0, "maximum": 33554431},
        "alias": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+$"},
        "version": {"type": "integer", "minimum": 1},
        "statement": {"type": "string", "minLength": 1},
        "stakeholder": {"type": "string"},
        "priority": {"type": "integer", "minimum": 1},
        "rationale": {"type": "string"},
        "acceptance": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "anchors": {"type": "array", "items": {"type": "string"}},
        "tbd": {"$ref": "tbx.schema.json"} } } } } }
