#!/usr/bin/env python3
"""req — the requirements CLI. v0.5.

Working: mint, resolve, lint (strict schemas + identity + quality,
severity-by-scope), version (hash-lock reconcile / pin cascade / --check
drift / --audit ledger), xref (one reference grammar incl. HOLEs), render
(+--verify), trace (registry/INDEX/register), slice, rtm, measure,
migrate (audit/merge/apply), baseline, init.
Stubbed: sync, new (need a live GitHub project).
Deps: pyyaml + jsonschema (+ arxivhaiku for mint/resolve/projection checks;
other commands degrade gracefully without it).
"""
import argparse, json, os, re, subprocess, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from reqlib import hashing, quality, refs, schemas, versioning
from reqlib.refs import MalformedReferenceError

ROOT = Path(__file__).resolve().parent.parent
DOCS, BUILD = ROOT / "docs", ROOT / "build"
ANCHOR_RE = re.compile(r"\[#([0-9A-HJKMNP-TV-Z]{5})(?:@(\d+))?\]")
IMPL_RE = re.compile(r"req:(implements|witnesses)\s+([a-z0-9@,\-._ ]+)", re.I)
SKIP_DIRS = ("elicitation",)   # transcripts quote aliases; never scanned

try:
    import yaml
except ImportError:
    sys.exit("req: pyyaml required (pip install pyyaml)")
try:
    import arxivhaiku as ah
    from arxivhaiku import codec as ahc   # crockford fns live here in v1.0.2
except ImportError:
    ah = ahc = None  # mint/resolve will explain; everything else works


# ---------- config & corpus ---------------------------------------------------
def config():
    p = ROOT / "req.yaml"
    return (yaml.safe_load(p.read_text()) or {}) if p.exists() else {}


def separator():
    return config().get("alias_separator", "-")


def is_placeholder(row):
    return (row.get("alias") in ("word-word", "word.word")
            or row.get("uid") == "00000" or row.get("id") == 0)


def is_template(path):
    """*.template.* files are copy-and-edit sources — never authored truth,
    excluded from every gate. Owners may delete or keep them for reference."""
    return ".template." in path.name


def yaml_files():
    for sub in ["prd", "brd", "profiles", "trace"]:
        for f in sorted((DOCS / sub).glob("*.yaml")):
            if not f.name.startswith("_") and not is_template(f):
                yield f


def yaml_rows():
    """Yield (file, kind, row) for every ID'd row in every authored layer."""
    kinds = {"prd": [("requirements", "prd")],
             "brd": [("requirements", "brd")],
             "profiles": [("stakeholders", "stakeholder"),
                          ("constraints", "constraint")]}
    for f in yaml_files():
        data = yaml.safe_load(f.read_text()) or {}
        if f.parent.name == "profiles" and isinstance(data, dict) \
                and "alias" in data:
            yield f, "profile", data       # the profile itself is an identity
        for key, kind in kinds.get(f.parent.name, []):
            for row in (data.get(key) or []):
                if isinstance(row, dict) and "alias" in row:
                    yield f, kind, row


def md_files(include_skipped=False):
    if (ROOT / "README.md").exists():   # the root document carries the vision
        yield ROOT / "README.md"
    for f in sorted(DOCS.rglob("*.md")):
        if is_template(f):
            continue
        if include_skipped or f.parent.name not in SKIP_DIRS:
            yield f


def md_anchors():
    """Yield (file, lineno, token, version, text) for prose anchors.
    Code spans/fences are examples, never anchors — same rule as refs."""
    for f in md_files():
        in_fence = False
        for i, line in enumerate(f.read_text().splitlines(), 1):
            if line.lstrip().startswith("```"):
                in_fence = not in_fence
                continue
            if in_fence:
                continue
            for m in ANCHOR_RE.finditer(re.sub(r"`[^`\n]*`", "", line)):
                if m.group(1) != "XXXXX":
                    yield f, i, m.group(1), int(m.group(2) or 1), line.strip()


def normative_text(row):
    return (row.get("text") or row.get("statement") or row.get("role")
            or row.get("slug") or "")


def all_identities():
    ids = {}  # alias -> record ; token -> record for anchors
    for f, kind, row in yaml_rows():
        ids[str(row["alias"])] = {
            "kind": kind, "file": str(f.relative_to(ROOT)),
            "uid": row.get("uid"), "version": row.get("version", 1)}
    for f, fm, body in scenario_files():
        if fm and "alias" in fm:
            ids[str(fm["alias"])] = {
                "kind": "scenario", "file": str(f.relative_to(ROOT)),
                "uid": fm.get("uid"), "version": fm.get("version", 1)}
    for f, ln, tok, ver, text in md_anchors():
        ids[tok] = {"kind": "anchor", "file": str(f.relative_to(ROOT)),
                    "line": ln, "version": ver, "text": text[:100]}
    return ids


def lock_items():
    """{key: {version, text}} for every *real* identity — what the
    versions.lock ledger covers (docs/process.md §2). Anchors key by token."""
    items = {}
    for f, kind, row in yaml_rows():
        if is_placeholder(row):
            continue
        items[str(row["uid"])] = {"version": row.get("version", 1),
                                  "text": normative_text(row)}
    for f, fm, body in scenario_files():
        if fm and fm.get("uid"):
            items[str(fm["uid"])] = {"version": fm.get("version", 1),
                                     "text": body.strip()}
    for f, ln, tok, ver, text in md_anchors():
        items[tok] = {"version": ver,
                      "text": ANCHOR_RE.sub("", text).strip()}
    return items


def links_data():
    p = DOCS / "trace/links.yaml"
    return (yaml.safe_load(p.read_text()) or {}) if p.exists() else {}


def scenario_files():
    """Yield (file, front_matter_dict_or_None, body) for real scenarios.
    A scenario is a first-class identity whose actor is a stakeholder
    (process.md §3): front-matter uid/alias/version/slug/mode + the
    stakeholder_uid/alias/name triple."""
    for f in sorted((DOCS / "scenarios").glob("*.md")):
        if is_template(f):
            continue
        text = f.read_text()
        parts = text.split("---")
        if len(parts) > 2 and not parts[0].strip():
            try:
                fm = yaml.safe_load(parts[1]) or {}
            except (yaml.YAMLError, ValueError):
                fm = None
            yield f, fm, "---".join(parts[2:])
        else:
            yield f, None, text


# ---------- commands ----------------------------------------------------------
def cmd_mint(args):
    if not ah:
        sys.exit("req mint: arxivhaiku required (pip install arxivhaiku)")
    sep = args.separator or separator()
    taken = set()
    for _, _, r in yaml_rows():
        u = r.get("uid")
        if isinstance(u, str) and u != "00000":
            try:
                taken.add(ahc.decode_crockford(u))
            except Exception:
                pass
    for key in versioning.load_lock(ROOT):   # ledger keys: never re-mint
        try:
            taken.add(ahc.decode_crockford(key))
        except Exception:
            pass
    for _ in range(64):
        alias = ah.haiku(separator=sep)
        can = ah.decode(alias, separator=sep)
        if can not in taken:
            print(f"{ahc.encode_crockford(can)}\t{alias}\t{can}")
            return
    sys.exit("req mint: could not find free identity (registry nearly full?)")


def cmd_resolve(args):
    x = args.ref.strip()
    forms = {}
    if ah:
        try:
            if x.isdigit():
                can = int(x)
            elif re.fullmatch(r"[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{5}", x):
                can = ahc.decode_crockford(x)
            else:
                can = ah.decode(x, separator=separator())
            forms = {"canonical": can, "alias": ah.encode(can, separator=separator()),
                     "token": ahc.encode_crockford(can)}
        except Exception:
            pass
    ids = all_identities()
    hit = ids.get(forms.get("alias", x)) or ids.get(forms.get("token", "")) or ids.get(x)
    print(json.dumps({"query": x, **forms, "found": hit}, indent=2))


def wordlist_findings():
    """Pinned wordlist digests vs the installed arxivhaiku (req.yaml)."""
    import hashlib
    pins = (config().get("wordlists") or {})
    if not pins:
        return [], ["req.yaml carries no wordlist pins (add adjectives_sha256/"
                    "nouns_sha256 — they detect a silent alias-projection change)"]
    if not ah:
        return [], ["wordlist pins present but arxivhaiku not installed"]
    fails = []
    for name, words in [("adjectives", ah.list_adjectives()),
                        ("nouns", ah.list_nouns())]:
        h = hashlib.sha256(("\n".join(words) + "\n").encode()).hexdigest()
        if pins.get(f"{name}_sha256") and pins[f"{name}_sha256"] != h:
            fails.append(f"wordlist pin mismatch: {name} — installed arxivhaiku "
                         f"would change every alias projection")
    return fails, []


def scan_ref_surfaces():
    """Yield (where, text) for every surface the reference grammar covers:
    row text/statement/rationale, links targets, ADR/review markdown."""
    for f, kind, row in yaml_rows():
        where = f"{f.name}:{row['alias']}"
        yield where, normative_text(row)
        if row.get("rationale"):
            yield where + ":rationale", row["rationale"]
    for f in md_files():
        # code spans/fences are examples, not citations — never scanned
        body = re.sub(r"```.*?```", "", f.read_text(), flags=re.S)
        yield f.name, re.sub(r"`[^`\n]*`", "", body)


def cmd_lint(args):
    fails, warns = [], []
    deny = quality.compile_denylist(
        yaml.safe_load((ROOT / "tools/denylist.yaml").read_text()) or {})
    wl_f, wl_w = wordlist_findings()
    fails += wl_f
    warns += wl_w
    sep = separator()
    changed = versioning.changed_keys(ROOT) if not args.strict_new else None
    strict_all = args.strict_new or changed is None

    # schema validation (strict — unknown keys are errors; resolves R-5)
    flow_re = re.compile(r"(:\s*\{)|(^\s*-\s*\{)")
    for f in yaml_files():
        for i, line in enumerate(f.read_text().splitlines(), 1):
            code = line.split("#", 1)[0]
            if flow_re.search(code):
                fails.append(f"{f.name}:{i}: flow mapping {{…}} — block "
                             f"style is mandatory in authored YAML (commas "
                             f"inside braces silently create stray keys)")
        try:
            data = yaml.safe_load(f.read_text()) or {}
        except yaml.YAMLError as e:
            fails.append(f"{f.name}: unparseable YAML: {e}")
            continue
        fails += schemas.validate(f, data)

    # identity checks
    seen_ids, seen_aliases = {}, {}
    stakeholder_aliases = {}
    for f, kind, row in yaml_rows():
        if kind == "stakeholder" and not is_placeholder(row):
            stakeholder_aliases[row["alias"]] = row.get("uid")
    for f, kind, row in yaml_rows():
        a, u = row["alias"], row.get("uid")
        if is_placeholder(row):
            continue
        if a in seen_aliases:
            fails.append(f"duplicate alias {a}: {f.name} & {seen_aliases[a]}")
        seen_aliases[a] = f.name
        if isinstance(u, str):
            if u in seen_ids and seen_ids[u] != a:
                fails.append(f"uid {u} used by {a} and {seen_ids[u]}")
            seen_ids[u] = a
            if ah:
                try:
                    want = ah.encode(ahc.decode_crockford(u), separator=sep)
                except Exception:
                    want = None
                if want and want != a:
                    fails.append(f"{a}: alias is not the projection of uid "
                                 f"{u} (expected {want})")
        if kind == "brd":
            su, sa = row.get("stakeholder_uid"), row.get("stakeholder_alias")
            if ah and isinstance(su, str):
                try:
                    want = ah.encode(ahc.decode_crockford(su), separator=sep)
                except Exception:
                    want = None
                if want and want != sa:
                    fails.append(f"{a}: stakeholder_alias {sa} is not the "
                                 f"projection of stakeholder_uid {su}")
            if sa and sa not in stakeholder_aliases:
                fails.append(f"{a}: stakeholder_alias {sa} matches no "
                             f"stakeholder row in any profile")
        # quality findings — error on changed rows, warn corpus-wide (K-19)
        for code, msg in quality.check_row(kind, row, deny):
            finding = f"{a}: [{code}] {msg}"
            (fails if strict_all or (changed and a in changed) else warns
             ).append(finding)
        if kind == "prd":
            if any(k in row for k in ("priority_stakeholder", "priority_buying")):
                fails.append(f"{a}: customer priority field in PRD "
                             f"(belongs in BRD — see docs/process.md §3)")
            if row.get("type") == "definition":
                if "priority_po" in row:
                    fails.append(f"{a}: priority_po on a definition row "
                                 f"(docs/process.md §13)")
            else:
                po = row.get("priority_po")
                if not isinstance(po, int) or not 1 <= po <= 5:
                    fails.append(f"{a}: priority_po missing or not an int "
                                 f"1–5 (docs/process.md §3)")

    # filename ↔ contents (profiles carry their alias; BRDs carry their
    # profile's alias — names can never go stale because lint checks them)
    PREFIX = {"customer": "CP", "internal": "IP"}
    profile_kind = {}
    for f in (DOCS / "profiles").glob("*.yaml"):
        if is_template(f):
            continue
        data = yaml.safe_load(f.read_text()) or {}
        pal, pk = data.get("alias"), data.get("kind")
        if pal:
            profile_kind[pal] = pk
        if pal and pal not in ("word-word", "word.word") and pk in PREFIX:
            want = f"{PREFIX[pk]}_{pal}"
            if f.stem != want:
                fails.append(f"{f.name}: filename must be {want}.yaml "
                             f"(<kind prefix>_<profile alias>)")
    for f in (DOCS / "brd").glob("*.yaml"):
        if is_template(f):
            continue
        data = yaml.safe_load(f.read_text()) or {}
        pal = ((data.get("meta") or {}).get("profile") or "")
        pk = profile_kind.get(pal)
        if pal and pal not in ("word-word", "word.word"):
            if pk is None:
                fails.append(f"{f.name}: meta.profile {pal} matches no "
                             f"profile alias")
            else:
                want = f"BRD-{PREFIX[pk]}_{pal}"
                if f.stem != want:
                    fails.append(f"{f.name}: filename must be {want}.yaml "
                                 f"(BRD-<kind prefix>_<profile alias>)")

    # scenarios: front-matter schema, actor triple, filename S_<alias>.md
    for f, fm, body in scenario_files():
        if fm is None:
            fails.append(f"{f.name}: scenario needs YAML front-matter "
                         f"(uid/alias/version/slug/mode + stakeholder triple)")
            continue
        if jsonschema_available := True:
            import jsonschema as _js
            v = _js.Draft7Validator(schemas._load("scenario.schema.json"))
            for e in sorted(v.iter_errors(fm), key=lambda e: list(e.absolute_path)):
                loc = "/".join(str(x) for x in e.absolute_path) or "<front-matter>"
                fails.append(f"{f.name}: {loc}: {e.message}")
        a, u = fm.get("alias"), fm.get("uid")
        su, sa = fm.get("stakeholder_uid"), fm.get("stakeholder_alias")
        if ah and isinstance(u, str) and isinstance(a, str):
            try:
                want = ah.encode(ahc.decode_crockford(u), separator=sep)
            except Exception:
                want = None
            if want and want != a:
                fails.append(f"{f.name}: alias {a} is not the projection of "
                             f"uid {u} (expected {want})")
        if ah and isinstance(su, str):
            try:
                want = ah.encode(ahc.decode_crockford(su), separator=sep)
            except Exception:
                want = None
            if want and want != sa:
                fails.append(f"{f.name}: stakeholder_alias {sa} is not the "
                             f"projection of stakeholder_uid {su}")
        if sa and sa not in stakeholder_aliases:
            fails.append(f"{f.name}: stakeholder_alias {sa} matches no "
                         f"stakeholder row in any profile")
        if a and f.stem != f"S_{a}":
            fails.append(f"{f.name}: filename must be S_{a}.md "
                         f"(S_<scenario alias>)")

    # reference grammar well-formedness (malformed [[...]] never skips)
    for where, text in scan_ref_surfaces():
        try:
            refs.scan(text, where)
        except MalformedReferenceError as e:
            fails.append(str(e))

    # version drift vs the ledger (K-17)
    items = lock_items()
    lock = versioning.load_lock(ROOT)
    if items or lock:
        fails += versioning.drift(items, lock)

    # anchor density; architecture budget + code-path tripwires
    for f in md_files():
        lines = f.read_text().splitlines()
        n = sum(1 for l in lines
                if ANCHOR_RE.search(l) and "[#XXXXX]" not in l)
        if lines and n / max(len(lines), 1) > 0.125:
            warns.append(f"{f.name}: anchor density {n}/{len(lines)} > 1/8")
    arch = DOCS / "architecture.md"
    if arch.exists():
        atext = arch.read_text()
        alines = atext.splitlines()
        if len(alines) > 200:
            fails.append(f"architecture.md over budget: {len(alines)}/200 lines")
        cited = []
        for m in re.finditer(r"`((?:src|lib|app|scripts)/[^`]+)`", atext):
            if "<" in m.group(1):
                continue                       # template placeholder
            cited.append(m.group(1))
            if not (ROOT / m.group(1)).exists():
                fails.append(f"architecture.md cites missing path {m.group(1)}")
        # module rows must cover every top-level source dir (map ↔ territory)
        for d in ("src", "lib", "app"):
            if (ROOT / d).is_dir() and not any(c.startswith(d + "/") or c == d
                                               for c in cited):
                fails.append(f"architecture.md: top-level {d}/ has no module "
                             f"row (the map must cover the territory)")
        # ADR index completeness: every non-superseded ADR appears; every
        # cited ADR exists
        adr_ids = {f.stem for f in (DOCS / "decisions").glob("*.md")
                   if not f.stem.startswith("00000000")}
        idx = atext.split("## ADR index")[-1] if "## ADR index" in atext else ""
        for m in re.finditer(r"\b(\d{8}_\d{6}_[a-z0-9-]+)\b", idx):
            if m.group(1) not in adr_ids:
                fails.append(f"architecture.md ADR index cites missing ADR "
                             f"{m.group(1)}")
        for aid in sorted(adr_ids):
            fm = {}
            try:
                head = (DOCS / "decisions" / f"{aid}.md").read_text().split("---")
                fm = yaml.safe_load(head[1]) if len(head) > 2 else {}
            except Exception:
                pass
            status = str((fm or {}).get("status", ""))
            if not status.startswith(("superseded", "rejected")) and aid not in idx:
                fails.append(f"architecture.md ADR index missing {aid} "
                             f"(status: {status or '?'})")

    for w in warns:
        print(f"WARN  {w}")
    for e in fails:
        print(f"FAIL  {e}")
    sys.exit(1 if fails else 0)


def cmd_version(args):
    items = lock_items()
    lock = versioning.load_lock(ROOT)

    if args.check:
        errs = versioning.drift(items, lock)
        for e in errs:
            print(f"FAIL  {e}")
        sys.exit(1 if errs else 0)

    if args.audit:
        errs, note = versioning.audit(ROOT, items, base=args.base)
        if note:
            print(note)
        for e in errs:
            print(f"FAIL  {e}")
        sys.exit(1 if errs else 0)

    new_lock, bumped, added, orphaned = versioning.reconcile(items, lock)

    # write reconciled versions back into the tree (textual — comments survive)
    for f in yaml_files():
        text = orig = f.read_text()
        for key, (_, newv) in bumped.items():
            # bump the row's own version line — lock keys are UIDs, so
            # anchor on the row's uid line (quoted or bare)
            pat = re.compile(
                r"(uid:\s*\"?" + re.escape(key) +
                r"\"?(?:.|\n){0,200}?version:\s*)(\d+)")
            text = pat.sub(lambda m: m.group(1) + str(newv), text, count=1)
        text, _ = versioning.cascade_file(text, bumped)
        if text != orig:
            f.write_text(text)
    for f in list(md_files()) + [p for p in (ROOT / "tests").rglob("*")
                                 if (ROOT / "tests").exists() and p.is_file()]:
        text = orig = f.read_text()
        for key, (_, newv) in bumped.items():
            if len(key) == 5 and key.isupper():   # anchor: bump its own tag
                text = re.sub(r"\[#" + key + r"(@\d+)?\]",
                              f"[#{key}@{newv}]", text)
        text, _ = versioning.cascade_file(text, bumped)
        if text != orig:
            f.write_text(text)

    versioning.save_lock(ROOT, new_lock)
    # verify the textual write-back round-trips (fail loudly, never silently)
    errs = versioning.drift(lock_items(), new_lock)
    for e in errs:
        print(f"FAIL  post-reconcile drift: {e}")
    print(f"version: {len(new_lock)} entries · bumped {len(bumped)} · "
          f"added {len(added)} · retired {len(orphaned)}")
    for k, (o, n) in sorted(bumped.items()):
        print(f"  {k}: {o} → {n} (inbound pins cascaded)")
    sys.exit(1 if errs else 0)


def cmd_xref(args):
    ids = all_identities()
    fails = []
    hole_count = 0
    # structured targets: row refs + links.yaml
    sections = {yaml.safe_load(f.read_text()).get("section")
                for f in (DOCS / "prd").glob("*.yaml")
                if not f.name.startswith("_")}
    for f, kind, row in yaml_rows():
        if is_placeholder(row):
            continue
        for r in (row.get("refs") or []):
            alias, _, ver = r.partition("@")
            if alias not in ids:
                fails.append(f"{f.name}:{row['alias']}: refs unknown {alias}")
            elif ver and int(ver) != ids[alias]["version"]:
                fails.append(f"{f.name}:{row['alias']}: stale pin {r} "
                             f"(current @{ids[alias]['version']})")
    for l in (links_data().get("links") or []):
        for target in [l.get("from")] + list(l.get("spec") or []):
            if not target:
                continue
            m = refs.SECTION_RE.match(target)
            if m:
                if m.group(1) not in sections:
                    fails.append(f"links.yaml: unknown section:{m.group(1)}")
                continue
            alias, _, ver = target.partition("@")
            if alias == "word-word":
                continue
            if alias not in ids:
                fails.append(f"links.yaml: unknown target {alias}")
            elif ver and int(ver) != ids[alias]["version"]:
                fails.append(f"links.yaml: stale pin {target} "
                             f"(current @{ids[alias]['version']})")
    # inline grammar on every surface: dangling, stale, holes
    for where, text in scan_ref_surfaces():
        try:
            rs, holes = refs.scan(text, where)
        except MalformedReferenceError as e:
            fails.append(str(e))
            continue
        for alias, ver, _ in rs:
            if alias not in ids:
                fails.append(f"{where}: dangling [[{alias}]]")
            elif ver is not None and ver != ids[alias]["version"]:
                fails.append(f"{where}: stale pin [[{alias}@{ver}]] "
                             f"(current @{ids[alias]['version']})")
        hole_count += len(holes)
    if hole_count:
        fails.append(f"{hole_count} open HOLE reference(s) — the spec cannot "
                     f"pass while judgement is pending (req migrate)")
    for d in fails:
        print(f"FAIL  {d}")
    sys.exit(1 if fails else 0)


def cmd_trace(args):
    BUILD.mkdir(exist_ok=True)
    ids = all_identities()
    (BUILD / "registry.json").write_text(json.dumps(ids, indent=1, sort_keys=True))
    lines = ["# INDEX (derived — do not edit)\n"]
    for sub in ["../README.md", "profiles", "brd", "scenarios", "prd",
                "trace/links.yaml", "decisions", "architecture.md"]:
        label = "README.md" if sub.startswith("..") else sub
        p = (DOCS / sub).resolve()
        if p.is_file():
            lines.append(f"- {label} — {len(p.read_text().splitlines())} lines")
        elif p.is_dir():
            for f in sorted(p.glob("*")):
                if f.is_file():
                    lines.append(f"- {label}/{f.name} — {len(f.read_text().splitlines())} lines")
    lines.append(f"\nidentities: {len(ids)}")
    (BUILD / "INDEX.md").write_text("\n".join(lines) + "\n")
    reg = ["# Register (derived)\n"]
    for f, kind, row in yaml_rows():
        tb = row.get("tbd")
        if tb:
            reg.append(f"- [{tb.get('disposition','open')}] {row['alias']} "
                       f"({f.name}) — {tb.get('question','?')} · owner {tb.get('owner','?')} "
                       f"· trigger {tb.get('trigger','?')}")
    for f in DOCS.rglob("*.md"):
        if f.parent.name != "decisions":
            continue
        head = f.read_text().split("---")
        if len(head) > 2:
            try:
                fm = yaml.safe_load(head[1]) or {}
            except (yaml.YAMLError, ValueError):
                fm = {}
            if fm.get("tbd"):
                t = fm["tbd"]
                reg.append(f"- [{t.get('disposition','deferred')}] {fm.get('id', f.name)} — "
                           f"{t.get('question','?')} · trigger {t.get('trigger','?')}")
    (BUILD / "register.md").write_text("\n".join(reg) + "\n")
    print(f"trace: {len(ids)} identities → build/ (registry, INDEX, register)")
    if args.gate:
        g = rtm_graph()
        _, blocking = rtm_gaps(g)
        for b in blocking:
            print(f"FAIL  {b}")
        if blocking or g["orphan_cites"]:
            for b in g["orphan_cites"]:
                print(f"FAIL  {b}")
            sys.exit(1)


def cmd_slice(args):
    q = args.expr.strip()
    out = [f"# slice: {q} (derived)\n"]
    target = q.split(":", 1)[-1]
    for f, kind, row in yaml_rows():
        if row["alias"] == target or target in (row.get("refs") or []):
            out.append(yaml.dump(row, sort_keys=False))
    for l in (links_data().get("links") or []):
        if target in ([l.get("brd")] + list(l.get("spec") or [])):
            out.append(yaml.dump(l, sort_keys=False))
    BUILD.mkdir(exist_ok=True)
    p = BUILD / "slices" / (re.sub(r"[^a-z0-9-]", "_", target) + ".md")
    p.parent.mkdir(exist_ok=True)
    p.write_text("\n".join(out))
    print(p)


def _cell(text):
    """Inline rendering for table cells: pins hidden from readers
    (`alias`), holes loud (⟨HOLE: …⟩), pipes escaped."""
    text = refs.HOLE_RE.sub(lambda m: f"⟨HOLE: {m.group('phrase')}⟩", text)
    text = refs.REF_RE.sub(lambda m: f"`{m.group(1)}`", text)
    return text.replace("|", "\\|").replace("\n", " ")


def _banner(layer):
    return (f"<!-- GENERATED by `req render` from docs/{layer}/ — do not "
            f"edit; edit the YAML and re-run. -->\n")


def render_views():
    """Deterministic readable views of the row-based layers.
    Returns {relative_path: content}."""
    views = {}
    # PRD
    lines = ["# PRD (rendered view)", "", _banner("prd")]
    for f in sorted((DOCS / "prd").glob("*.yaml")):
        if f.name.startswith("_") or is_template(f):
            continue
        data = yaml.safe_load(f.read_text()) or {}
        rows = data.get("requirements") or []
        lines.append(f"## {data.get('section', f.stem)}")
        defs = [r for r in rows if r.get("type") == "definition"]
        reqs = [r for r in rows if r.get("type") != "definition"]
        if defs:
            lines += ["", "**Definitions**", "",
                      "| Term | Definition | ID |", "|---|---|---|"]
            lines += [f"| {_cell(str(r.get('term', '')))} | "
                      f"{_cell(r.get('text', ''))} | `{r['alias']}` |"
                      for r in defs]
        if reqs:
            lines += ["", "| UID | ID | Requirement | Type | Witness | Notes |",
                      "|---|---|---|---|---|---|"]
            lines += [f"| `{r.get('uid', '')}` | "
                      f"`{r['alias']}`@{r.get('version', 1)} | "
                      f"{_cell(r.get('text', ''))} | {r.get('type', '')} | "
                      f"{r.get('witness', '')} | "
                      f"{_cell(r.get('rationale', '') or '')} |"
                      for r in reqs]
        lines.append("")
    views["prd.md"] = "\n".join(lines)
    # BRD
    lines = ["# BRD (rendered view)", "", _banner("brd")]
    for f in sorted((DOCS / "brd").glob("*.yaml")):
        if f.name.startswith("_") or is_template(f):
            continue
        data = yaml.safe_load(f.read_text()) or {}
        meta = data.get("meta") or {}
        lines += [f"## {f.stem} — profile {meta.get('profile', '?')}", "",
                  "| UID | ID | Statement | Stakeholder | P stk | P buy | Acceptance | Source |",
                  "|---|---|---|---|---|---|---|---|"]
        lines += [f"| `{r.get('uid', '')}` | "
                  f"`{r['alias']}`@{r.get('version', 1)} | "
                  f"{_cell(r.get('statement', ''))} | "
                  f"{_cell(str(r.get('stakeholder_name', '')))} | "
                  f"{r.get('priority_stakeholder', '')} | "
                  f"{r.get('priority_buying', '')} | "
                  f"{_cell(r.get('acceptance', ''))} | "
                  f"{_cell(r.get('source', ''))} |"
                  for r in (data.get("requirements") or [])]
        lines.append("")
    views["brd.md"] = "\n".join(lines)
    # profiles
    lines = ["# Profiles (rendered view)", "", _banner("profiles")]
    for f in sorted((DOCS / "profiles").glob("*.yaml")):
        if f.name.startswith("_") or is_template(f):
            continue
        data = yaml.safe_load(f.read_text()) or {}
        head = (f"## `{data.get('alias', '')}` (`{data.get('uid', '')}`) "
                f"— {data.get('slug', '')} "
                f"({data.get('kind', '?')}, rank {data.get('rank', '?')}")
        head += f", {data['status']})" if data.get("status") else ")"
        lines.append(head)
        for key, col in [("stakeholders", "role"), ("constraints", "text")]:
            rows = data.get(key) or []
            if rows:
                lines += ["", f"**{key.capitalize()}**", "",
                          f"| ID | {col} |", "|---|---|"]
                lines += [f"| `{r['alias']}`@{r.get('version', 1)} | "
                          f"{_cell(str(r.get(col, '')))} |" for r in rows]
        lines.append("")
    views["profiles.md"] = "\n".join(lines)
    # links
    lines = ["# Trace links (rendered view)", "", _banner("trace"),
             "| BRD | Relation | PRD targets | Note |", "|---|---|---|---|"]
    for l in (links_data().get("links") or []):
        lines.append(f"| `{l.get('brd', '')}` | {l.get('relation', '')} | "
                     f"{', '.join(f'`{s}`' for s in (l.get('spec') or []))} | "
                     f"{_cell(l.get('note', '') or '')} |")
    lines.append("")
    views["links.md"] = "\n".join(lines)
    return views


def cmd_render(args):
    out_dir = BUILD / "render"
    views = render_views()
    if args.verify:
        fails = []
        for name, content in views.items():
            p = out_dir / name
            if not p.exists():
                fails.append(f"render --verify: {p.relative_to(ROOT)} missing "
                             f"(run `req render`)")
            elif p.read_text() != content:
                fails.append(f"render --verify: {p.relative_to(ROOT)} differs "
                             f"from the authored YAML (hand-edited or stale)")
        for e in fails:
            print(f"FAIL  {e}")
        sys.exit(1 if fails else 0)
    out_dir.mkdir(parents=True, exist_ok=True)
    for name, content in views.items():
        (out_dir / name).write_text(content)
    print(f"render: {len(views)} views → {out_dir.relative_to(ROOT)}/")


