{ "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "required": ["meta", "requirements"],
  "additionalProperties": false,
  "properties": {
    "meta": { "type": "object", "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {"type": "string"},
        "version": {"type": ["number", "string"]} } },
    "requirements": { "type": "array", "maxItems": 40, "items": {
      "type": "object",
      "required": ["uid","alias","version","statement","stakeholder_uid",
                   "stakeholder_alias","stakeholder_name",
                   "priority_stakeholder","priority_buying","acceptance","source"],
      "additionalProperties": false,
      "properties": {
        "uid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{5}$"},
        "alias": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+$"},
        "version": {"type": "integer", "minimum": 1},
        "statement": {"type": "string", "minLength": 1},
        "stakeholder_uid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{5}$"},
        "stakeholder_alias": {"type": "string", "pattern": "^[a-z]+[-._][a-z]+$"},
        "stakeholder_name": {"type": "string", "minLength": 1},
        "priority_stakeholder": {"type": "integer", "minimum": 1},
        "priority_buying": {"type": "integer", "minimum": 1},
        "rationale": {"type": "string"},
        "acceptance": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "anchors": {"type": "array", "items": {"type": "string"}},
        "tbd": {"$ref": "tbx.schema.json"} } } } } }
